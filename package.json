{
  "name": "pxto-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run check:assets && npm run build",
    "check:assets": "node scripts/check-assets.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "audit": "npm run audit:functional && npm run audit:responsive && npm run audit:a11y && npm run audit:content && npm run audit:security && npm run audit:perf",
    "audit:functional": "node scripts/audit-functional.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "build:logo": "node scripts/build-logo.mjs",
    "audit:build": "NEXT_DIST_DIR=.next-audit next build",
    "audit:start": "NEXT_DIST_DIR=.next-audit next start",
    "prepare": "husky",
    "verify:staged": "node scripts/verify-staged.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "geist": "^1.3.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
