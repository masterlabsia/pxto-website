# Canonical site URL. Required. Used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Lead destination: a Notion database. Server only, never NEXT_PUBLIC_.
# Setup and expected columns: docs/technical/TECHNICAL_ARCHITECTURE.md section 13.
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# Rate limit do formulario (Upstash Redis, REST). Opcional: sem estas duas, o
# limite por IP e ignorado e o envio segue normalmente. Server only.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
